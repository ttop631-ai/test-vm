# NodeWatch 환경변수 예시 (SPEC §2.2, §5)
#   cp .env.example .env  후 값을 바꾼다. .env는 커밋하지 않는다 (.gitignore).
#   .env가 없어도 아래 기본값으로 동작한다.

# ---- 노출 포트 / 인증 ---------------------------------------------------
# 호스트에 노출하는 유일한 포트 (AWS 데모는 80)
CONSOLE_PORT=8080

# 대시보드·API HTTP Basic 인증. 외부에 노출하기 전에 반드시 변경한다.
ADMIN_USER=admin
ADMIN_PASSWORD=nodewatch

# console ↔ agent 토큰. 배포 시 임의의 긴 값으로 변경한다.
#   예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN_A=dev-token-a
AGENT_TOKEN_B=dev-token-b
AGENT_TOKEN_C=dev-token-c

# ---- 튜닝 (선택, 기본값은 SPEC §5) --------------------------------------
# POLL_INTERVAL_SEC=5
# HEALTH_CONNECT_TIMEOUT=1.0
# HEALTH_READ_TIMEOUT=3.0
# SLOW_MS=1500
# POLL_CONCURRENCY=20
# FAIL_THRESHOLD=3
# STALE_FACTOR=3
# CMD_CONNECT_TIMEOUT=2.0
# CMD_READ_TIMEOUT=15
# JOB_CONCURRENCY=10
# OUTPUT_MAX_BYTES=65536
# 노드별 메모리 샘플 수. 60 = 5분, 720 = 1시간 (최대 17280)
# SAMPLES_MAX=60
