# NodeWatch 환경변수 예시 (SPEC §2.2, §5)
#   cp .env.example .env  후 값을 바꾼다. .env는 커밋하지 않는다 (.gitignore).
#   .env가 없어도 아래 기본값으로 동작한다.

# ---- 노출 포트 / 인증 ---------------------------------------------------
# 호스트에 노출하는 유일한 포트 (AWS 데모는 80)
CONSOLE_PORT=8080

# 계정. 비밀번호는 평문이 아니라 scrypt 해시로 넣는다 (평문 ADMIN_PASSWORD가 있으면 console이 기동을 거부).
#   해시 생성:  docker compose run --rm console python -m app.auth hash
#   아래 값은 로컬 개발용 기본 비밀번호(nodewatch / monwatch)의 해시다. 외부에 노출하기 전에 반드시 바꾼다.
# 관리자 (전체 기능). API 스크립트는 같은 계정으로 Basic 헤더 사용
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:aoDLaDST1sgcQP-CvnOoaQ:5SoEo6qsVFhuLBADNWU3fVrjOASDC6ce6vVJOaMJ-T0
# 모니터링 (조회 전용: 일괄 제어·데모 제어 불가). MONITOR_USER를 비우면 계정 비활성
MONITOR_USER=monuser
MONITOR_PASSWORD_HASH=scrypt:16384:8:1:XR6RbF9eIJXh4vFWfHDz9w:XIQnORzfQw7P0uB98lhLYd-ZVhmzFplqtT1Chk3isac
# 로그인 세션 유효 시간(초), HTTPS 뒤에 두면 COOKIE_SECURE=true
# SESSION_TTL_SEC=28800
# COOKIE_SECURE=false
# 같은 IP 연속 로그인 실패 n회 → n초 차단
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SEC=60

# console ↔ agent 토큰. 배포 시 임의의 긴 값으로 변경한다.
#   예: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN_A=dev-token-a
AGENT_TOKEN_B=dev-token-b
AGENT_TOKEN_C=dev-token-c

# ---- 튜닝 (선택, 기본값은 SPEC §5) --------------------------------------
# POLL_INTERVAL_SEC=5
# HEALTH_CONNECT_TIMEOUT=1.0
# HEALTH_READ_TIMEOUT=3.0
# SLOW_MS=1500
# POLL_CONCURRENCY=20
# FAIL_THRESHOLD=3
# STALE_FACTOR=3
# 수집 주기 < HTTP_KEEPALIVE_EXPIRY < agent keep-alive(30s)
# HTTP_KEEPALIVE_EXPIRY=15
# CMD_CONNECT_TIMEOUT=2.0
# CMD_READ_TIMEOUT=15
# JOB_CONCURRENCY=10
# OUTPUT_MAX_BYTES=65536
# 노드별 메모리 샘플 수. 60 = 5분, 720 = 1시간 (최대 17280)
# SAMPLES_MAX=60
